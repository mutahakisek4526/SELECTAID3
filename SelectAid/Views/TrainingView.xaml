<UserControl x:Class="SelectAid.Views.TrainingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="20">
        <TextBlock Text="Training" FontSize="36" FontWeight="Bold" />
        <TextBlock Text="Dwell Practice" FontWeight="Bold" />
        <ProgressBar Height="30" Maximum="100" Value="{Binding DwellProgress}" />
        <StackPanel Orientation="Horizontal">
            <Button Content="Start" Command="{Binding StartDwellCommand}" />
            <Button Content="Stop" Command="{Binding StopDwellCommand}" />
        </StackPanel>
        <TextBlock Text="Metrics" FontWeight="Bold" Margin="0,20,0,0" />
        <TextBlock Text="{Binding Snapshot.ConfirmCount, StringFormat=Confirm: {0}}" />
        <TextBlock Text="{Binding Snapshot.UndoCount, StringFormat=Undo: {0}}" />
        <TextBlock Text="{Binding Snapshot.MistakeCount, StringFormat=Mistake: {0}}" />
        <TextBlock Text="{Binding Snapshot.AverageConfirmMs, StringFormat=Average Confirm (ms): {0}}" />
        <Button Content="Refresh" Command="{Binding RefreshMetricsCommand}" />
    </StackPanel>
</UserControl>
