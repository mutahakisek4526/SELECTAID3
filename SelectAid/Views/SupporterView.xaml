<UserControl x:Class="SelectAid.Views.SupporterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Margin="20">
        <StackPanel>
            <TextBlock Text="Input Mode" FontWeight="Bold" />
            <ComboBox ItemsSource="{Binding InputModes}" SelectedItem="{Binding SelectedMode}" />
            <TextBlock Text="Theme" FontWeight="Bold" />
            <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" />
            <CheckBox Content="High Contrast" IsChecked="{Binding HighContrast}" />
            <CheckBox Content="Auto Start" IsChecked="{Binding AutoStart}" />
            <CheckBox Content="Allow Power Controls" IsChecked="{Binding AllowPowerControls}" />
            <Button Content="Save" Command="{Binding SaveCommand}" />
            <TextBlock Text="Power Controls" FontWeight="Bold" Margin="0,20,0,0" />
            <UniformGrid Columns="4" Rows="1">
                <Button Content="Sleep" Command="{Binding ExecutePowerCommand}" CommandParameter="Sleep" />
                <Button Content="Shutdown" Command="{Binding ExecutePowerCommand}" CommandParameter="Shutdown" />
                <Button Content="Restart" Command="{Binding ExecutePowerCommand}" CommandParameter="Restart" />
                <Button Content="Logoff" Command="{Binding ExecutePowerCommand}" CommandParameter="Logoff" />
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
