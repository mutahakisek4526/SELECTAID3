<UserControl x:Class="SelectAid.Views.AacView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:SelectAid.Models"
             xmlns:views="clr-namespace:SelectAid.Views">
    <UserControl.Resources>
        <views:BooleanToBrushConverter x:Key="BooleanToBrushConverter" />
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Margin="6" Background="{StaticResource CardBrush}">
            <StackPanel>
                <TextBlock Text="History" FontWeight="Bold" />
                <ListBox ItemsSource="{Binding History}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <Border Grid.Row="0" Grid.Column="1" Margin="6" Background="{StaticResource CardBrush}">
            <StackPanel>
                <TextBlock Text="Compose" FontWeight="Bold" />
                <TextBox Text="{Binding ComposeText}" TextWrapping="Wrap" AcceptsReturn="True" Height="180" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Margin="6" Background="{StaticResource CardBrush}">
            <StackPanel>
                <TextBlock Text="Input" FontWeight="Bold" />
                <ComboBox ItemsSource="{Binding Layouts}" DisplayMemberPath="Name" SelectedItem="{Binding CurrentLayout}" />
                <ItemsControl ItemsSource="{Binding CurrentLayout.Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Keys}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:KeyDefinition}">
                                        <Button Content="{Binding Label}"
                                                Command="{Binding DataContext.KeyPressCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Margin="6" Background="{StaticResource CardBrush}">
            <StackPanel>
                <TextBlock Text="Controls" FontWeight="Bold" />
                <ItemsControl ItemsSource="{Binding ControlTargets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>\n                            <UniformGrid Columns=\"4\" Rows=\"2\" />\n                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}"
                                    Command="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                <Setter Property="BorderThickness" Value="4" />
                                                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Label}" Value="Buzzer" />
                                                    <Condition Binding="{Binding DataContext.BuzzerActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="Red" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <UniformGrid Columns="3" Rows="1">
                    <Button Content="Pause" Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Button Content="Overlay" Command="{Binding DataContext.OverlayCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Button Content="Home" Command="{Binding DataContext.HomeCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </UniformGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
