<UserControl x:Class="SelectAid.Views.PhrasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Scene" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding Scenes}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedScene}" Width="260" />
            <TextBlock Text="Category" VerticalAlignment="Center" Margin="20,0,8,0" />
            <ComboBox ItemsSource="{Binding SelectedScene.Categories}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCategory}" Width="260" />
        </StackPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding SelectedCategory.Items}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Text}" Width="600" TextWrapping="Wrap" />
                        <Button Content="Speak" Command="{Binding DataContext.SpeakPhraseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        <Button Content="Insert" Command="{Binding DataContext.InsertPhraseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBox Text="{Binding NewPhrase}" Width="600" />
            <Button Content="Add" Command="{Binding AddPhraseCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
