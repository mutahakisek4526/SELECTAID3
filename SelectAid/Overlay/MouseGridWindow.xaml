<Window x:Class="SelectAid.Overlay.MouseGridWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mouse Grid" Height="600" Width="800"
        WindowStyle="ToolWindow" Topmost="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <UniformGrid x:Name="GridCells" Grid.Row="0" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Cancel" Click="OnCancel" />
            <Button Content="Left Click" Click="OnLeftClick" />
            <Button Content="Right Click" Click="OnRightClick" />
        </StackPanel>
    </Grid>
</Window>
