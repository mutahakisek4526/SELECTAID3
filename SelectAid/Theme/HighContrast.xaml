<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="HighContrastPrimaryColor">#FFFFFFFF</Color>
    <Color x:Key="HighContrastAccentColor">#FFFFEB3B</Color>
    <Color x:Key="HighContrastBackgroundColor">#FF000000</Color>
    <Color x:Key="HighContrastCardColor">#FF1A1A1A</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource HighContrastPrimaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource HighContrastAccentColor}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource HighContrastBackgroundColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource HighContrastCardColor}" />

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
    </Style>
</ResourceDictionary>
