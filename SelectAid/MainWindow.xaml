<Window x:Class="SelectAid.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SelectAid.Views"
        xmlns:vm="clr-namespace:SelectAid.ViewModels"
        Title="SelectAid" Height="900" Width="1400" WindowState="Maximized">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AacViewModel}">
            <views:AacView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PhrasesViewModel}">
            <views:PhrasesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:KeyboardLayoutsViewModel}">
            <views:KeyboardLayoutsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SupporterViewModel}">
            <views:SupporterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TrainingViewModel}">
            <views:TrainingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}">
            <views:LogsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackupRestoreViewModel}">
            <views:BackupRestoreView />
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource CardBrush}" Padding="12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="SelectAid" FontSize="32" FontWeight="Bold" Margin="0,0,12,0" />
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                <ProgressBar Width="200" Height="20" Margin="24,0,0,0" Value="{Binding DwellProgress}" Maximum="100" />
            </StackPanel>
        </Border>
        <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" />
        <Border Grid.Row="2" Background="{StaticResource CardBrush}" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Home" Command="{Binding HomeCommand}" />
                <Button Content="Back" Command="{Binding BackCommand}" />
                <Button Content="Undo" Command="{Binding UndoCommand}" />
                <Button Content="Pause" Command="{Binding PauseCommand}" />
                <Button Content="Buzzer" Command="{Binding BuzzerCommand}" />
                <Button Content="PC(Overlay)" Command="{Binding OverlayCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
